          "has_examples(prompt: str) -> bool - I/O 예시 감지",
          "has_specific_values(prompt: str) -> bool - 숫자/조건 감지",
          "count_recovered_specs(state: MainGraphState) -> int",
          "generate_summary(prompt: str, spec_result: dict) -> str (100자)"
        ],
        "modify_output": "TurnAnalysis 객체 반환 추가"
      }
    },
    {
      "task_id": "6b-3",
      "name": "TurnAnalysis 저장 로직",
      "status": "pending",
      "files": [
        "app/application/services/eval_service.py",
        "app/domain/langgraph/nodes/handle_request.py"
      ],
