          },
          {
            "name": "calculate_follow_up_score",
            "description": "후속 턴 점수 계산 (25%)"
          },
          {
            "name": "calculate_efficiency_score",
            "description": "효율성 점수 계산 (20%)"
          }
        ],
        "evaluation_type": "rule_based",
        "note": "LLM 호출 없이 규칙 기반으로 점수 계산"
      }
    },
    {
      "task_id": "6b-5",
