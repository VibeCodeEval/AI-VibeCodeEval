      "action": "modify",
      "details": {
        "add_node": "integrated_evaluator",
        "connection": "main_router → integrated_evaluator → eval_holistic_flow (또는 내부 호출)"
      }
    },
    {
      "task_id": "6b-6",
      "name": "최종 점수 통합",
