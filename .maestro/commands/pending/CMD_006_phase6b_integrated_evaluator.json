  "description": "기존 Turn Evaluator + Holistic Flow + Spec 평가를 Spec 중심으로 통합. 첫 프롬프트 품질을 최우선으로 평가하고, 후속 턴은 보완/회복으로 평가.",

  "philosophy": {
    "core_principle": "불완전한 코드는 첫 프롬프트의 불완전한 Spec에서 비롯된다",
    "weight_distribution": {
      "first_prompt": "55% (Spec 완전성 35% + 표현 품질 20%)",
      "follow_up_turns": "25% (맥락 연결 15% + Spec 회복 10%)",
      "efficiency": "20% (턴 수 + 회복 속도)"
    }
  },

  "evaluation_metrics": {
    "total_metrics": 6,
    "details": [
      {
        "id": 1,
        "name": "spec_completeness",
        "weight": 0.35,
        "description": "필수 Spec 명시 여부 (알고리즘, 자료구조, 시간복잡도 등)"
      },
      {
        "id": 2,
        "name": "clarity",
        "weight": 0.07,
        "description": "구체적 값, 조건 명시 여부"
      },
      {
        "id": 3,
        "name": "structure",
        "weight": 0.07,
        "description": "XML 태그, 마크다운, 리스트 활용"
      },
      {
        "id": 4,
        "name": "specificity",
        "weight": 0.06,
        "description": "I/O 예시, 엣지 케이스 포함"
      },
      {
        "id": 5,
        "name": "context_connection",
        "weight": 0.25,
        "description": "이전 턴 참조, Spec 회복 품질"
      },
      {
        "id": 6,
        "name": "efficiency",
        "weight": 0.20,
        "description": "턴 수, 회복 속도"
      }
    ]
  },

  "tasks": [
    {
      "task_id": "6b-1",
      "name": "TurnAnalysis 모델 정의",
      "status": "pending",
      "file": "app/domain/langgraph/states.py",
      "action": "modify",
      "details": {
        "add_models": [
          {
            "name": "TurnAnalysis",
            "fields": [
              "turn: int",
              "is_first_prompt: bool",
              "spec_completeness: float (0-100)",
              "specified_specs: List[str]",
              "missing_specs: List[dict]",
              "clarity_score: float (0-100)",
              "has_structure: bool",
              "has_examples: bool",
              "has_specific_values: bool",
              "spec_recovery_count: int",
              "references_previous: bool",
              "summary: str (max 100자)"
            ]
          },
          {
            "name": "SessionAnalysis",
            "fields": [
              "session_id: str",
              "turn_analyses: List[TurnAnalysis]",
              "final_spec_completeness: float",
              "spec_recovery_timeline: List[dict]"
            ]
          }
        ],
        "modify_state": {
          "MainGraphState": [
            "turn_analysis: Optional[Dict]",
            "integrated_score: Optional[float]"
          ]
        }
      }
    },
    {
      "task_id": "6b-2",
      "name": "Spec Extractor 확장",
      "status": "pending",
      "file": "app/domain/langgraph/nodes/spec_extractor.py",
